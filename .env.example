# =============================================================================
# Job Intelligence Engine — Environment Variables (secrets + per-environment)
# =============================================================================
# Copy to .env and fill in values.
#
# This file holds ONLY:
#   1. Secrets (API keys, DB DSNs, auth tokens)
#   2. Per-environment endpoints (hostnames, deployment names, ports)
#   3. Per-tenant identifiers (tenant allowlists, request headers)
#
# Non-secret tuning knobs (thresholds, batch sizes, concurrency, retry
# policies, LLM routing, cost tables, etc.) live in `config/*.yaml`.
# See `config/README.md` for the per-file glossary and the env-override
# convention. Legacy env overrides remain functional during the deprecation
# window (issue #210).

PYTHONIOENCODING=utf-8  # Required on Windows (Crawl4AI unicode)

# --- Google Gemini (set llm.provider=gemini in config/llm.yaml to use) ---
GEMINI_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# --- Azure OpenAI Embeddings ---
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_API_VERSION="2024-02-01"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=embeddings-te3small

# --- Observability ---
LANGCHAIN_TRACING_V2=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Cloud: https://us.cloud.langfuse.com  |  Local Docker: http://localhost:3001
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- Database (PostgreSQL + SQLAlchemy) ---
# Local Docker:  postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/talent_finder
# Azure:         postgresql+psycopg2://azadmin:<password>@pg-jobintel-cfa-dev.postgres.database.azure.com:5432/talent_finder?sslmode=require
PYTHON_DATABASE_URL=
# Optional read-only URL for Streamlit / dashboards (see dashboard/readonly_engine.py)
PYTHON_DATABASE_URL_READONLY=
# Azure admin DSN. Same SQLAlchemy format as PYTHON_DATABASE_URL.
# Read by scripts/sync_embeddings_from_azure.py. The JIE engine in
# common/data_store/database.py will only fall back to this DSN when
# JIE_ALLOW_AZURE_DB_FALLBACK=1 is set explicitly (off by default to
# protect the source-of-truth Azure DB from accidental writes).
AZURE_POSTGRES_DATABASE_URL=
JIE_ALLOW_AZURE_DB_FALLBACK=

# --- Message Bus (Redis Streams) ---
REDIS_URL=redis://localhost:6379/0

# --- Ingestion (JSearch Pro plan — 10,000 req/month, issue #157) ---
# Slot 1 holds the paid Pro-plan key. Slots 2–4 optional (overflow/future tiers).
# JSearch tuning (country, retries, throttle, etc.) lives in `config/ingestion.yaml`.
# Monthly budget remains in `config/ingestion_queries.yaml`.
JSEARCH_API_KEY=                                  # paid Pro-plan key (slot 1)
JSEARCH_API_KEY_2=                                # optional overflow
JSEARCH_API_KEY_3=                                # optional overflow
JSEARCH_API_KEY_4=                                # optional overflow

# --- POST /analytics/query API keys (JIE #226, LaborPulse / wfd-os) ---
# Server allowlist: JSON array of { "key_id": "...", "secret": "..." }.
# Logs record key_id only; never log the secret.
#
# Local dev quick start (qa-eval --use-http and similar CLI flows):
#   The JIE_API_KEYS[].secret MUST match ANALYTICS_QUERY_X_API_KEY exactly —
#   the server-side allowlist and the outbound client header are two ends of the
#   same secret. Generate one hex value, paste it into both places. Example:
#
#   JIE_API_KEYS=[{"key_id":"local-dev-1","secret":"a1b2c3d4e5f6789012345678abcdef01"}]
#   ANALYTICS_QUERY_X_TENANT_ID=borderplex
#   ANALYTICS_QUERY_X_USER_EMAIL=you@example.com
#   ANALYTICS_QUERY_X_API_KEY=a1b2c3d4e5f6789012345678abcdef01
#
# (Replace the secret with your own random hex; the value above is illustrative only.)
#
# In bash, assign with single quotes so JSON double-quotes and `!` do not break parsing:
#   JIE_API_KEYS='[{"key_id":"local-dev-1","secret":"local-dev-secret"}]'
# JIE_API_KEYS=[{"key_id":"local-dev-1","secret":"REPLACE_ME"}]
JIE_API_KEYS=
# Or point to a YAML/JSON file with the same list shape:
# JIE_API_KEYS_FILE=config/jie_api_keys.local.yaml
JIE_API_KEYS_FILE=
# Clients (dashboard, curl, smoke scripts) must send: X-API-Key: <secret matching one entry>
# LaborPulse POST /analytics/query also requires X-Tenant-Id, X-User-Email, X-Request-Id (JIE #222):
ANALYTICS_QUERY_X_TENANT_ID=
ANALYTICS_QUERY_X_USER_EMAIL=
# ANALYTICS_QUERY_X_REQUEST_ID=          # optional; if empty, clients generate a UUID per request
ANALYTICS_QUERY_X_API_KEY=
# JIE #224 — X-Tenant-Id allowlist (analytics/tenant_scope.py). Unknown IDs -> 400 invalid_tenant_id.
# JIE_TENANT_ALLOWLIST=borderplex,puget_sound

# --- Analytics API server (per-env hostnames) ---
# ANALYTICS_API_HOST=127.0.0.1
# ANALYTICS_API_PORT=8000
# ANALYTICS_QUERY_BASE_URL=http://127.0.0.1:8000

# --- External enrichment APIs (Phase 2 — Phase 1 adapters are mocks) ---
# BLS_API_KEY=                                      # Bureau of Labor Statistics
# CENSUS_API_KEY=                                   # US Census Bureau
# ONET_CLIENT_ID=                                   # O*NET Web Services
# ONET_API_KEY=                                     # O*NET Web Services

# --- Windows Encoding (auto-set by Crawl4AI adapter if missing) ---
# PYTHONUTF8=1
