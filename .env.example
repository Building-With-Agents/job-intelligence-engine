# =============================================================================
# Job Intelligence Engine — Environment Variables
# =============================================================================
# Copy to .env and fill in values

PYTHONIOENCODING=utf-8  # Required on Windows (Crawl4AI unicode)

# --- LLM Provider & Routing ---
# Available providers: azure_openai | gemini | mock | anthropic
# LLM_PROVIDER is the default provider for all calls.
# Each LLM_* var can optionally override the provider with colon syntax:
#   LLM_SYNTHESIS=gemini:gemini-2.5-pro  (uses Gemini instead of LLM_PROVIDER)
LLM_PROVIDER=azure_openai
LLM_DEFAULT=chat-gpt41mini              # Haiku-class — default for all calls
LLM_SYNTHESIS=chat-gpt41                 # Sonnet-class — Q&A answer generation, complex reasoning
# LLM_EXTRACTION=                        # Override for skills extraction (optional)
# LLM_EXTRACTION_TASKS=                  # Override for tasks extraction (optional, defaults to LLM_DEFAULT)
# LLM_EXTRACTION_RESPONSIBILITIES=       # Override for responsibilities extraction (optional)
# LLM_EXTRACTION_NAICS=                  # Override for NAICS classification (optional)
# LLM_EXTRACTION_EMPLOYER=               # Override for employer classification (optional)
# LLM_CLASSIFICATION=                    # Override for intent classification (optional)
# LLM_ANALYTICS=                         # Override for analytics summaries (optional)

# --- Google Gemini (set LLM_PROVIDER=gemini to use, or use colon syntax above) ---
GEMINI_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# --- Azure OpenAI Embeddings ---
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_API_VERSION="2024-02-01"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=embeddings-te3small

# --- Observability ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Cloud: https://us.cloud.langfuse.com  |  Local Docker: http://localhost:3000
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Database (PostgreSQL + SQLAlchemy) ---
# Local Docker:  postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/talent_finder
# Azure:         postgresql+psycopg2://azadmin:<password>@pg-jobintel-cfa-dev.postgres.database.azure.com:5432/talent_finder?sslmode=require
PYTHON_DATABASE_URL=
AZURE_POSTGRES_DATABASE_URL=

# --- Message Bus (Redis Streams) ---
REDIS_URL=redis://localhost:6379/0

# --- Ingestion (JSearch Pro plan — 10,000 req/month, issue #157) ---
# Slot 1 holds the paid Pro-plan key. Slots 2–4 optional (overflow/future tiers).
# Monthly budget + per-request throttle are configured in config/ingestion_queries.yaml.
JSEARCH_API_KEY=                                  # paid Pro-plan key (slot 1)
JSEARCH_API_KEY_2=                                # optional overflow
JSEARCH_API_KEY_3=                                # optional overflow
JSEARCH_API_KEY_4=                                # optional overflow
JSEARCH_START_KEY_INDEX=1                         # MUST be 1 — slot 1 is the paid key
JSEARCH_MAX_RETRIES=2                             # per-page retries on JSearch 429
JSEARCH_RETRY_BASE_DELAY_SECONDS=10               # initial JSearch 429 backoff
JSEARCH_RETRY_MAX_DELAY_SECONDS=60                # max JSearch 429 backoff
# Throttle — batch_ingest.py sets these from YAML `throttle` block; override here
# if running the adapter standalone.
# JSEARCH_RPS=5                                   # Pro-tier limit
# JSEARCH_RPM=250
SCRAPING_TARGETS=                         # Comma-separated target URLs
INGESTION_SCHEDULE=0 2 * * *              # Cron — default: daily at 2am

# --- Pipeline Thresholds ---
SPAM_FLAG_THRESHOLD=0.7                   # Flag for operator review above this
SPAM_REJECT_THRESHOLD=0.9                 # Auto-reject above this
SKILL_CONFIDENCE_THRESHOLD=0.75
BATCH_SIZE=100

# --- Skills Extraction ---
SKILLS_EXTRACTION_PARALLEL=1              # Run intra-job + inter-job async extraction
SKILLS_EXTRACTION_CONCURRENCY=5           # Max jobs in flight when parallel mode is enabled
# Deprecated serial-only throttles (used when SKILLS_EXTRACTION_PARALLEL=0):
SKILLS_EXTRACTION_CHUNK_SIZE=5
SKILLS_EXTRACTION_CHUNK_COOLDOWN=30
SKILLS_EXTRACTION_DELAY=1.0
SKILLS_EXTRACTION_LLM_TIMEOUT=120            # Seconds — LLM call timeout for structured extraction
SKILLS_EXTRACTION_MAX_JOBS=0                  # Max jobs per run (0 = unlimited, useful for testing)

# --- Enrichment (proven stable config — do NOT increase concurrency above 5) ---
# Root cause: classify_soc() and classify_naics_async() make sync DB calls inside
# asyncio.gather. At concurrency > 5, these exhaust the SQLAlchemy connection pool
# causing indefinite hangs with no error output. See issue #149 for the fix plan.
ENRICHMENT_PARALLEL=1                     # 1 = async parallel, 0 = serial fallback
ENRICHMENT_CONCURRENCY=5                  # MUST be <= 5 — higher values hang (issue #149)
ENRICHMENT_LLM_TIMEOUT=120               # Seconds — gather timeout for SOC+NAICS+employer per job

# --- Database Pool ---
DB_POOL_SIZE=30                           # SQLAlchemy connection pool size
DB_MAX_OVERFLOW=20                        # Extra connections above pool_size

# --- Enrichment Extras ---
SPAM_PREVIEW_ALLOW_HEURISTIC=false            # Enable heuristic spam scoring fallback when LLM unavailable
SKILL_TAXONOMY_SIMILARITY_THRESHOLD=0.92      # Embedding similarity for skill→ESCO matching (0.0-1.0)

# --- Analytics Guardrails (Week 7) ---
STALENESS_THRESHOLD_MINUTES=15            # Minutes before aggregate computed_at is stale
CARDINALITY_CAP=500                       # Max distinct values per category dimension
FRESH_THRESHOLD_DAYS=30                   # Postings newer than this = "fresh"
STALE_THRESHOLD_DAYS=90                   # Postings older than this = "expired"
ANALYTICS_DISABLE_MINIMUM_DATA_GUARD=false    # Set true to bypass 50-row minimum (testing only)
ANALYTICS_CLUSTERING_LOAD_LIMIT=              # Cap records loaded for role clustering (optional, default unlimited)

# --- Ingestion Scheduling (alternative to INGESTION_SCHEDULE cron) ---
# INGESTION_INTERVAL_MINUTES=               # Run ingestion every N minutes (APScheduler mode)
# INGESTION_CRON_EXPRESSION=                # Alternative cron expression format

# --- LLM Cost Overrides (optional — advanced) ---
# Override hardcoded pricing in common/llm_adapter.py PRICING dict.
# Useful for negotiated enterprise rates or new model pricing.
# All values are cost per token (not per 1M tokens).
# GPT41_INPUT_COST_PER_TOKEN=0.000002
# GPT41_OUTPUT_COST_PER_TOKEN=0.000008
# GPT41MINI_INPUT_COST_PER_TOKEN=0.0000004
# GPT41MINI_OUTPUT_COST_PER_TOKEN=0.0000016
# SONNET_INPUT_COST_PER_TOKEN=0.000003
# SONNET_OUTPUT_COST_PER_TOKEN=0.000015
# HAIKU_INPUT_COST_PER_TOKEN=0.0000008
# HAIKU_OUTPUT_COST_PER_TOKEN=0.000004

# --- Windows Encoding (auto-set by Crawl4AI adapter if missing) ---
# PYTHONUTF8=1                               # Required on Windows for Crawl4AI subprocess encoding
